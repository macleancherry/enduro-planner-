{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enduro-plan",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-03-21",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enduro-planner-db",
      "database_id": "67d7eb13-0793-469c-98b6-c6ac7cc66d72"
    }
  ],
  "vars": {
    "LIVE_WORKER_URL": "https://ignium-live-api.example.workers.dev"
  }
}
