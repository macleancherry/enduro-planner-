# Copy this to .dev.vars for local development (gitignored, never commit real secrets).
# In production these are set with `wrangler secret put <NAME>`.

# The team passcode typed on the login screen.
PASSCODE=changeme

# Signing key for the auth cookie. Generate a real one with: openssl rand -hex 32
PASSCODE_HMAC_SECRET=dev-only-secret-change-in-production
