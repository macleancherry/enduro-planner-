{
  "name": "enduro-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply enduro-planner-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply enduro-planner-db --remote",
    "db:seed:local": "wrangler d1 execute enduro-planner-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute enduro-planner-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "drizzle-orm": "^0.36.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^0.1.9",
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
